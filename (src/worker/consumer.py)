import asyncio
from src.agent.core import WorkerAgent
from src.config import settings

async def process_task(task_payload: dict, agent: WorkerAgent):
    task_id = task_payload.get("id")
    prompt = task_payload.get("instruction")
    
    try:
        # Enforce maximum execution window
        result = await asyncio.wait_for(agent.run(prompt), timeout=settings.TASK_TIMEOUT_SECONDS)
        # Publish success result to database/queue
        print(f"Task {task_id} completed: {result[:80]}...")
    except asyncio.TimeoutError:
        print(f"Task {task_id} timed out.")
    except Exception as exc:
        print(f"Task {task_id} failed with error: {exc}")

